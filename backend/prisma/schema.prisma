  fibLevel      Float     @default(0)   // es. 0.618
  fibLevelName  String    @default("")  // es. "61.8%"
  fibPrice      Float     @default(0)   // prezzo esatto del livello
  // Flow data
  vwap          Float     @default(0)
  volumeRatio   Float     @default(0)
  delta         Float     @default(0)
  deltaRatio    Float     @default(0)
  feeRate       Float     @default(0.0006)
