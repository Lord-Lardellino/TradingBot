# MEXC API Credentials
# Get from: https://www.mexc.com/user/openapi
MEXC_API_KEY=your_api_key_here
MEXC_API_SECRET=your_api_secret_here

# App
PORT=3000
NODE_ENV=development

# Paper trading mode (true = no real orders placed)
TEST_MODE=true

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Gemini API
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram MTProto
# Get TG_API_ID and TG_API_HASH from: https://my.telegram.org
# Generate TG_SESSION with: npm run tg:login
TG_API_ID=your_telegram_api_id_here
TG_API_HASH=your_telegram_api_hash_here
TG_SESSION=your_telegram_string_session_here
